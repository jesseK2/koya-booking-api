{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/reset", "destination": "/api/reset" },
    { "source": "/slots", "destination": "/api/slots" },
    { "source": "/bookings", "destination": "/api/bookings" },
    { "source": "/bookings/:id", "destination": "/api/booking?id=:id" }
  ]
}
